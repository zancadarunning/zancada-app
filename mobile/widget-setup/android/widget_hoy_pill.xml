<?xml version="1.0" encoding="utf-8"?>
<!--
  DÓNDE VA: android/app/src/main/res/drawable/widget_hoy_pill.xml

  Fondo tipo "chip" para la etiqueta HOY: mismo criterio que las variables
  hivis-dim de index.html (lima al 14% de opacidad como fondo detrás de
  texto lima), el mismo lenguaje visual que ya usan los tags/badges de la
  app (ej. "NATIVO"/"CONECTADO" en la pantalla de Relojes) en vez de texto
  suelto sin nada atrás.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="#26D6FF3F" />
</shape>
