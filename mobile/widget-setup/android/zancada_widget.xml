<?xml version="1.0" encoding="utf-8"?>
<!--
  DÓNDE VA: android/app/src/main/res/layout/zancada_widget.xml

  Layout del widget. Colores tomados a mano de la paleta oscura de Zancada
  (variables asphalt-2/chalk/mist/hivis en index.html) y mismo radius de
  26dp que usan las cards de la app: el widget no puede leer el CSS, así
  que todo queda hardcodeado acá, pero apunta a verse como una card más de
  la propia app, no como un recuadro nativo genérico.

  Diseño inspirado en los widgets nativos de iOS (Apple Fitness, Nike Run
  Club "Last Run"): el número (distancia/tiempo) es el elemento con más
  peso visual de la card, no una leyenda chica al pie: ese número grande
  lo arma ZancadaWidgetProvider.kt como texto con estilos mixtos (número
  grande y en negrita, unidad chica y gris), no acá en el XML: RemoteViews
  no tiene una forma directa de poner dos tamaños de letra en la misma
  línea sin eso.

  Sin ícono de marca (se sacó por pedido explícito): la identidad de
  Zancada queda solo en el fondo (widget_card_bg.xml) y en el color lima
  del texto, sin un logo posta compitiendo con el dato real.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/widget_session_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_hoy_pill"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="HOY"
            android:textColor="#D6FF3F"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- ImageView, no View liso: RemoteViews (lo que arma un widget de
                 pantalla de inicio) solo sabe inflar un set fijo de clases, y
                 android.view.View no está en esa lista: confirmado con un
                 crash real en el dispositivo ("Error inflating class
                 android.view.View"). ImageView sí, y de paso permite
                 tintear el color con setColorFilter() desde el provider. -->
            <ImageView
                android:id="@+id/widget_zone_dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="7dp"
                android:src="@drawable/widget_zone_dot"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#EDEFEF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2" />
        </LinearLayout>

        <!-- El número hero: ZancadaWidgetProvider.kt le arma un
             SpannableString (RelativeSizeSpan + StyleSpan + ForegroundColorSpan)
             para que la cifra salga grande/negrita/clara y la unidad
             ("km"/"min") chica y gris, ambas en esta misma TextView: por
             eso el tamaño/color acá son solo la base sobre la que esos spans
             escalan, no el resultado final. fontFamily sans-serif-black (no
             monospace): a este tamaño una tipografía "black"/ultra-negrita
             lee como un número hero con mucha más presencia que una
             monoespaciada, que a igual tamaño se ve más angosta/técnica.
             Probado en un dispositivo real, el cambio se nota. -->
        <TextView
            android:id="@+id/widget_amount_big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#EDEFEF"
            android:textSize="19sp"
            android:fontFamily="sans-serif-black"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_empty_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zancada"
            android:textColor="#D6FF3F"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Abrí la app para ver tu sesión de hoy"
            android:textColor="#8B9296"
            android:textSize="14sp"
            android:gravity="center"
            android:maxLines="2" />
    </LinearLayout>
</FrameLayout>
