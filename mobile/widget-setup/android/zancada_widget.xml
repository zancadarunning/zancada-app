<?xml version="1.0" encoding="utf-8"?>
<!--
  DÓNDE VA: android/app/src/main/res/layout/zancada_widget.xml

  Layout del widget. Colores tomados a mano de la paleta oscura de Zancada
  (variables asphalt-2/chalk/mist/hivis en index.html) y mismo radius de
  26dp que usan las cards de la app: el widget no puede leer el CSS, así
  que todo queda hardcodeado acá, pero apunta a verse como una card más de
  la propia app, no como un recuadro nativo genérico.

  Diseño inspirado en los widgets nativos de iOS (Apple Fitness, Nike Run
  Club "Last Run"): el número (distancia/tiempo) es el elemento con más
  peso visual de la card, no una leyenda chica al pie: ese número grande
  lo arma ZancadaWidgetProvider.kt como texto con estilos mixtos (número
  grande y en negrita, unidad chica y gris), no acá en el XML: RemoteViews
  no tiene una forma directa de poner dos tamaños de letra en la misma
  línea sin eso.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:padding="16dp">

    <!-- Marca chica en la esquina: el mismo ícono redondo del launcher, a
         muy baja prominencia (como suelen hacer los widgets de iOS: la
         marca se intuye, no compite con el dato real). -->
    <ImageView
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_gravity="top|end"
        android:src="@mipmap/ic_launcher_round"
        android:alpha="0.55"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_session_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOY"
            android:textColor="#D6FF3F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- ImageView, no View liso: RemoteViews (lo que arma un widget de
                 pantalla de inicio) solo sabe inflar un set fijo de clases, y
                 android.view.View no está en esa lista: confirmado con un
                 crash real en el dispositivo ("Error inflating class
                 android.view.View"). ImageView sí, y de paso permite
                 tintear el color con setColorFilter() desde el provider. -->
            <ImageView
                android:id="@+id/widget_zone_dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="7dp"
                android:src="@drawable/widget_zone_dot"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#EDEFEF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2" />
        </LinearLayout>

        <!-- El número hero: ZancadaWidgetProvider.kt le arma un
             SpannableString (RelativeSizeSpan + StyleSpan + ForegroundColorSpan)
             para que la cifra salga grande/negrita/clara y la unidad
             ("km"/"min") chica y gris, ambas en esta misma TextView: por
             eso el tamaño/color acá son solo la base sobre la que esos spans
             escalan, no el resultado final. fontFamily monospace para que
             las cifras queden tabulares, igual criterio que .mono en
             index.html para los números de stats. -->
        <TextView
            android:id="@+id/widget_amount_big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#EDEFEF"
            android:textSize="19sp"
            android:fontFamily="monospace"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_empty_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginBottom="10dp"
            android:alpha="0.9"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zancada"
            android:textColor="#EDEFEF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Abrí la app para ver tu sesión de hoy"
            android:textColor="#8B9296"
            android:textSize="14sp"
            android:gravity="center"
            android:maxLines="2" />
    </LinearLayout>
</FrameLayout>
