<?xml version="1.0" encoding="utf-8"?>
<!--
  DÓNDE VA: android/app/src/main/res/drawable/widget_card_bg.xml

  Fondo de "card" redondeada para el widget: mismo radius de 26dp y borde
  sutil tipo overlay-hairline que usan las cards de index.html, pero con un
  gradiente diagonal muy sutil (en vez de un solo color plano) para darle
  algo de profundidad: inspirado en cómo los widgets nativos de iOS
  (Apple Fitness, Nike Run Club) casi nunca usan un fondo 100% chato, aunque
  la diferencia entre los dos extremos acá es mínima a propósito: la idea es
  que se note "hay algo ahí" sin que se vea un degradé de app genérica.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <stroke android:width="1dp" android:color="#0BFFFFFF" />
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#1D1D21"
        android:endColor="#131315" />
</shape>
