<?xml version="1.0" encoding="utf-8"?>
<!--
  DÓNDE VA: android/app/src/main/res/drawable/widget_card_bg.xml

  Fondo de "card" redondeada para el widget : mismos valores que .card en
  index.html (fondo asphalt-2, radius de 26dp, borde sutil tipo
  overlay-hairline). En Android 12+ el sistema ya redondea el widget solo,
  pero en versiones anteriores (ej. el Moto E6 Plus de prueba, Android 9) no
  hace nada por su cuenta: sin este drawable el widget se ve como un
  rectángulo con esquinas filosas pegado directo al home screen.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#18181B" />
    <corners android:radius="26dp" />
    <stroke android:width="1dp" android:color="#0BFFFFFF" />
</shape>
