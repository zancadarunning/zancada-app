<?xml version="1.0" encoding="utf-8"?>
<!--
  DÓNDE VA: android/app/src/main/res/drawable/widget_card_bg.xml

  Fondo "mesh gradient" con sombra propia, en capas (layer-list): no una
  imagen de textura. RemoteViews puede tener cualquier drawable como
  background porque eso lo resuelve el sistema de recursos, no el inflador
  restringido de vistas (esa limitación es solo sobre qué CLASES DE VISTA
  puede armar RemoteViews, ver el comentario en zancada_widget.xml).

  Capas de abajo hacia arriba:
  1. Sombra: un óvalo oscuro y difuso apoyado justo debajo del borde
     inferior de la card, ocupando TODO el ancho/alto del drawable (no
     recortado a los 28dp de radio de la card). Esta es la única capa que
     no está inset: las de arriba sí, dejando un margen de 10dp abajo
     para que esta sombra asome y la card se sienta apoyada sobre la
     pantalla, no pegada.
  2 y 3. La card en sí, insetBottom=10dp para dejarle lugar a la sombra:
     un negro casi puro (mismos tonos que ink/asphalt de index.html, no un
     gris carbón genérico) con dos resplandores lima apilados en la
     esquina superior derecha (dos radios distintos a la misma opacidad
     total que uno solo) para que la caída se sienta más gradual/suave en
     vez de un anillo brusco de un único radial de 2 puntas.

  A propósito SIN borde/stroke: un borde parejo alrededor de toda la card
  MÁS una sombra es justo el combo "card genérica" que hay que evitar. La
  sombra y el propio contraste del degradé contra el fondo ya definen el
  borde, no hace falta remarcarlo con una línea.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="200dp"
                android:centerX="0.5"
                android:centerY="0.92"
                android:startColor="#59000000"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item android:bottom="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#15161A"
                android:endColor="#08090A" />
        </shape>
    </item>
    <item android:bottom="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="120dp"
                android:centerX="0.88"
                android:centerY="0.06"
                android:startColor="#28D6FF3F"
                android:endColor="#00D6FF3F" />
        </shape>
    </item>
    <item android:bottom="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="210dp"
                android:centerX="0.88"
                android:centerY="0.06"
                android:startColor="#10D6FF3F"
                android:endColor="#00D6FF3F" />
        </shape>
    </item>
</layer-list>
