{
  "rewrites": [
    { "source": "/conectar", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/:dir(sql|docs|test|scripts|loadtest|mobile|email-templates|\\.github|\\.impeccable|\\.superpowers|\\.claude)/:path*", "destination": "/", "permanent": false },
    { "source": "/:file(DESIGN|PRODUCT)\\.md", "destination": "/", "permanent": false },
    { "source": "/:file((?:dark|light|v[0-9])_[a-z_]+)\\.png", "destination": "/", "permanent": false },
    { "source": "/CLAUDE-SECURITY-:rest*", "destination": "/", "permanent": false }
  ],
  "crons": [
    { "path": "/api/send-reminders", "schedule": "*/30 * * * *" },
    { "path": "/api/sync-strava", "schedule": "*/15 * * * *" },
    { "path": "/api/coros-sync", "schedule": "*/15 * * * *" },
    { "path": "/api/wahoo-sync", "schedule": "*/15 * * * *" },
    { "path": "/api/polar-sync", "schedule": "*/15 * * * *" },
    { "path": "/api/suunto-sync", "schedule": "0 6 * * *" },
    { "path": "/api/suunto-guides-cron", "schedule": "20 * * * *" },
    { "path": "/api/wahoo-plans-cron", "schedule": "40 * * * *" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "zancada-app.vercel.app" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), payment=(), usb=(), bluetooth=(), serial=(), hid=(), magnetometer=(), midi=(), geolocation=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://api.mapbox.com; media-src 'self' blob:; connect-src 'self' https://challenges.cloudflare.com https://smcicgaraqlvalxvdriz.supabase.co wss://smcicgaraqlvalxvdriz.supabase.co https://api.open-meteo.com https://api.mapbox.com https://events.mapbox.com; worker-src 'self' blob:; child-src 'self' blob:; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
