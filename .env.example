# .env.example — LISTA de las variables de entorno que usa el servidor (api/). Solo los NOMBRES, nunca valores reales.
#
# Las claves reales viven únicamente en Vercel (Project → Settings → Environment Variables, entorno Production).
# Para probar en tu compu con `vercel dev`, copiá este archivo a `.env.local` y completalo: .env y .env.* están en
# .gitignore, así que no se pueden subir a GitHub por error (el repositorio es PÚBLICO).
#
# test/perf/secrets-and-env.test.js falla si el código usa una variable que no está en esta lista.

# --- Base de datos (Supabase) --------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=          # clave de servicio: acceso total a la base, SOLO en el servidor

# --- Seguridad interna ---------------------------------------------------------------------------------------
CRON_SECRET=                   # los crons de Vercel la mandan en Authorization: Bearer ...
SITE_URL=                      # opcional

# --- Strava --------------------------------------------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_STATE_SECRET=
STRAVA_VERIFY_TOKEN=
STRAVA_SUBSCRIPTION_ID=

# --- Polar / Wahoo / COROS / Suunto --------------------------------------------------------------------------
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_STATE_SECRET=
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
WAHOO_STATE_SECRET=
COROS_CLIENT_ID=
COROS_STATE_SECRET=
SUUNTO_CLIENT_ID=
SUUNTO_CLIENT_SECRET=
SUUNTO_SUBSCRIPTION_KEY=       # la de la suscripción Production API de Suunto
SUUNTO_STATE_SECRET=
SUUNTO_NOTIFICATION_SECRET=

# --- Notificaciones push -------------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON= # el JSON completo de la cuenta de servicio, en una sola línea

# --- IA y servicios --------------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
CHAT_DAILY_LIMIT=              # opcional: mensajes por usuario por día
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
SENTRY_DSN=
